+#ifndef PIO_USB_BULK_FRAME_BUDGET_US
+// FM-1 Transporter: keep running bulk transactions within a frame until this
+// much of the 1 ms frame has elapsed (upstream does one packet per frame).
+#define PIO_USB_BULK_FRAME_BUDGET_US 700
+#endif
+
 void __not_in_flash_func(pio_usb_host_frame)(void) {
   if (!timer_active) {
     return;
   }
 
+  uint32_t const frame_start_us = time_us_32();
+
   pio_port_t *pp = PIO_USB_PIO_PORT(0);
 
   // Send SOF
@@ -294,10 +302,21 @@
           if (ep->ep_num == 0 && ep->data_id == USB_PID_SETUP) {
             usb_setup_transaction(pp, ep);
           } else {
